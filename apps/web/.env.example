# Absolute origin for metadata and future links. Set the real URL when deploying.
APP_URL=http://127.0.0.1:3000

# Local Docker development only. Use separate credentials for hosted databases.
DATABASE_URL=postgresql://user:password@127.0.0.1:5461/db

# Generate a unique value: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
EMAIL_FROM=Welio <noreply@hollen.app>
# Server-side Send Mail token, not an OAuth token; never use NEXT_PUBLIC_ here.
ZEPTOMAIL_SEND_MAIL_TOKEN=
# Deployment only: a client-IP header overwritten by your trusted reverse proxy.
# Leave unset locally: auth safely uses a shared rate-limit bucket per endpoint.
AUTH_TRUSTED_IP_HEADER=

# Protect POST /api/jobs/email when configuring a scheduler for the durable email queue.
# Generate a separate random secret of at least 32 characters.
EMAIL_JOB_SECRET=

# AI receptionist: Strands SDK with Amazon Bedrock (server-side only).
# Choose a region and a tool-capable model or inference profile available there.
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
# Supply AWS credentials via the standard SDK chain (prefer an IAM role in AWS).
# The AWS SDK automatically uses AWS_BEARER_TOKEN_BEDROCK when set; do not also
# pass it as a BedrockModel apiKey, or requests can contain duplicate auth headers.
# Global UTC-day model-call cap, shared by public chat and owner preview.
AI_DAILY_CALL_LIMIT=200

# Optional POST /api/mcp/[slug] server-to-server Streamable HTTP MCP endpoint.
# Configure a distinct >=32-character random secret for each enabled business.
# Convert the business slug to uppercase and replace hyphens with underscores:
# lagos-cleaning -> MCP_API_SECRET__LAGOS_CLEANING
# Keep these server-side; never use NEXT_PUBLIC_ or browser code.
MCP_API_SECRET__LAGOS_CLEANING=
# Optional exact public origins for remote MCP clients, comma-separated. Keep
# this MCP-only allowlist narrow (for example, your current HTTPS ngrok origin).
MCP_ALLOWED_ORIGINS=
# Explicit opt-in for external agents to confirm a real booking after customer approval.
# Defaults off. The web receptionist always keeps its separate human confirmation flow.
MCP_BOOKING_CONFIRMATION_ENABLED=false
