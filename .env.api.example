# Go API only. Use a fresh local database and replace the auth secret.
WELIO_ROLE=api
DATABASE_URL=postgres://user:password@127.0.0.1:5461/db?sslmode=disable
PUBLIC_URL=http://127.0.0.1:3000
API_SERVER_URL=http://127.0.0.1:8081
AUTH_SECRET=replace-with-at-least-32-random-bytes
TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional Bedrock API-key auth. Otherwise use the AWS SDK credential chain.
# AWS_BEARER_TOKEN_BEDROCK=replace-with-your-bedrock-api-key

# Optional external MCP booking demo.
# MCP_BOOKING_CONFIRMATION_ENABLED=true
# MCP_API_SECRETS_JSON='{"your-business-slug":"replace-with-a-random-secret-of-at-least-32-characters"}'
# For a public tunnel, set its exact host and origin:
# MCP_ALLOWED_HOSTS=your-tunnel-host.example
# MCP_ALLOWED_ORIGINS=https://your-tunnel-host.example
