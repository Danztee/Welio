{
  "name": "welio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write . && pnpm --recursive exec eslint --fix .",
    "check": "turbo run lint check && prettier --check .",
    "db:up": "docker compose -f docker-compose.yaml up -d --wait db",
    "db:generate": "turbo run db:generate --filter=@welio/db",
    "db:migrate": "turbo run db:migrate --filter=@welio/db"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.9"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  }
}
