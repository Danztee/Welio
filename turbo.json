{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": [
        "APP_URL",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "AUTH_TRUSTED_IP_HEADER",
        "EMAIL_FROM",
        "ZEPTOMAIL_SEND_MAIL_TOKEN",
        "AWS_REGION",
        "BEDROCK_MODEL_ID",
        "AI_DAILY_CALL_LIMIT",
        "EMAIL_JOB_SECRET",
        "MCP_API_SECRET",
        "MCP_BOOKING_CONFIRMATION_ENABLED",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_BEARER_TOKEN_BEDROCK",
        "AWS_PROFILE",
        "AWS_SHARED_CREDENTIALS_FILE",
        "AWS_CONFIG_FILE"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": [".next/types/**", ".next/dev/types/**", "next-env.d.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "APP_URL",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "AUTH_TRUSTED_IP_HEADER",
        "EMAIL_FROM",
        "ZEPTOMAIL_SEND_MAIL_TOKEN",
        "AWS_REGION",
        "BEDROCK_MODEL_ID",
        "AI_DAILY_CALL_LIMIT",
        "EMAIL_JOB_SECRET",
        "MCP_API_SECRET",
        "MCP_BOOKING_CONFIRMATION_ENABLED",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_BEARER_TOKEN_BEDROCK",
        "AWS_PROFILE",
        "AWS_SHARED_CREDENTIALS_FILE",
        "AWS_CONFIG_FILE"
      ]
    },
    "lint": {
      "outputs": []
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "APP_URL",
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "AUTH_TRUSTED_IP_HEADER",
        "EMAIL_FROM",
        "ZEPTOMAIL_SEND_MAIL_TOKEN",
        "AWS_REGION",
        "BEDROCK_MODEL_ID",
        "AI_DAILY_CALL_LIMIT",
        "EMAIL_JOB_SECRET",
        "MCP_API_SECRET",
        "MCP_BOOKING_CONFIRMATION_ENABLED",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_BEARER_TOKEN_BEDROCK",
        "AWS_PROFILE",
        "AWS_SHARED_CREDENTIALS_FILE",
        "AWS_CONFIG_FILE"
      ]
    },
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
