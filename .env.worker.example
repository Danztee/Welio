# Background worker only. It runs its health endpoint on a separate local port.
WELIO_ROLE=worker
HTTP_ADDR=127.0.0.1:8082
DATABASE_URL=postgres://user:password@127.0.0.1:5461/db?sslmode=disable
PUBLIC_URL=http://127.0.0.1:3000

# To enable transactional email, add EMAIL_FROM and ZEPTOMAIL_SEND_MAIL_TOKEN.
