# Copy to .env.production on the EC2 host, then replace every placeholder.
# Keep this file private (chmod 600); it contains deployment secrets.
# Filled by `make aws-up` after the Elastic IP is allocated.
PUBLIC_IP=replace-after-aws-stack-creation
APP_URL=https://replace-after-aws-stack-creation
COOKIE_DOMAIN=

# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-random-hex
AUTH_SECRET=replace-with-random-hex
MCP_API_SECRETS_JSON='{"lagos-cleaning":"replace-with-a-different-random-secret"}'

AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
AI_DAILY_CALL_LIMIT=10

# Leave blank to allow the web app origin for browser-based MCP requests.
MCP_ALLOWED_ORIGINS=
MCP_BOOKING_CONFIRMATION_ENABLED=true

ZEPTOMAIL_SEND_MAIL_TOKEN=replace-with-zeptomail-token
EMAIL_FROM='Welio <verified-sender@example.com>'
